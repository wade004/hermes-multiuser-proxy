# hermes-multiuser-proxy configuration
# Copy to .env and edit as needed

# Proxy listening address (default: 0.0.0.0:8787)
PROXY_HOST=0.0.0.0
PROXY_PORT=8787

# Upstream hermes-webui address (must match webui's actual bind)
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8788

# Session TTL in seconds (default: 604800 = 7 days)
SESSION_TTL=604800

# Data directory for users/sessions (default: ~/.hermes/webui)
# PROXY_DATA_DIR=/home/ubuntu/.hermes/webui
